{
  "mcpServers": {
    "youtrack": {
      "type": "http",
      "url": "https://youtrack.jetbrains.com/mcp",
      "headers": {
        "Authorization": "Bearer ${YOUTRACK_MCP_TOKEN}"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp", "--api-key", "${CONTEXT7_TOKEN}"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "miro": {
      "type": "http",
      "url": "https://mcp.miro.com/"
    }
  }
}
